---
import BaseLayout from '../layouts/BaseLayout.astro';
import { languages, ui, type Lang } from '../i18n';
import { homeUrl } from '../lib/url';

const lang: Lang = 'de';
const t = ui[lang];
const alternates = Object.fromEntries(languages.map((code) => [code, homeUrl(code)])) as Record<Lang, string>;
---
<BaseLayout lang={lang} title={`${t.notFound.title} | Luca Invernizzi`} description={t.notFound.text} alternates={alternates} noindex>
  <section class="container not-found">
    <p class="kicker">404</p>
    <h1 class="not-found__title">{t.notFound.title}</h1>
    <p class="not-found__text">{t.notFound.text}</p>
    <div class="actions">
      <a class="btn btn--primary" href={homeUrl('de')}>{t.notFound.back}</a>
      <a class="btn btn--secondary" href={homeUrl('en')} lang="en">{ui.en.notFound.back}</a>
      <a class="btn btn--secondary" href={homeUrl('it')} lang="it">{ui.it.notFound.back}</a>
    </div>
  </section>
</BaseLayout>
