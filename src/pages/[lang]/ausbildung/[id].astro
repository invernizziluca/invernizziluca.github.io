---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { UI, languages, type Lang } from '../../../i18n';
import { education } from '../../../data/site';

export function getStaticPaths() { return education.flatMap((item) => languages.map((lang) => ({ params: { lang, id: item.id }, props: { item, lang } }))); }
const item = Astro.props.item;
const lang = Astro.props.lang as Lang;
const ui = UI[lang];
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const to = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---
<BaseLayout lang={lang} title={`${item.title[lang]} - Luca Invernizzi`} description={item.role[lang]} educationId={item.id}>
  <main>
    <section class="section-padding py-10 sm:py-16">
      <div class="container-page">
        <a href={to(`${lang}/#ausbildung`)} class="inline-flex items-center gap-2 text-sm font-bold text-muted transition hover:text-ink">← {ui.education.back}</a>
        <div class="mt-8 grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
          <div class="reveal">
            <p class="kicker">{item.period}</p>
            <h1 class="mt-5 text-balance text-5xl font-black tracking-[-0.05em] sm:text-7xl">{item.title[lang]}</h1>
            <p class="mt-5 text-xl font-semibold text-caramelDark">{item.role[lang]}</p>
            <p class="mt-3 text-sm font-semibold text-muted">{item.place[lang]}</p>
          </div>
          <div class="reveal rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5">
            <ul class="grid gap-4">{item.bullets[lang].map((b: string) => <li class="flex gap-3 text-base leading-7 text-muted"><span class="mt-3 h-2 w-2 rounded-full bg-caramel"></span>{b}</li>)}</ul>
            {item.url && <a class="btn-secondary mt-7" href={item.url} target="_blank">Website ↗</a>}
          </div>
        </div>
        <div class="reveal mt-10 overflow-hidden rounded-[2.5rem] bg-white p-3 shadow-soft"><img src={asset(item.cover)} alt={item.title[lang]} class="aspect-[16/8] w-full rounded-[2rem] object-cover" /></div>
      </div>
    </section>
    <section class="section-padding py-12 sm:py-20"><div class="container-page"><p class="kicker">Galerie</p><div class="mt-8 grid gap-4 sm:grid-cols-2">{item.gallery.map((img: string) => <div class="reveal overflow-hidden rounded-[1.8rem] bg-white p-2 ring-1 ring-black/5"><img src={asset(img)} alt="" class="aspect-[4/3] w-full rounded-[1.4rem] object-cover" loading="lazy" /></div>)}</div></div></section>
  </main>
</BaseLayout>
