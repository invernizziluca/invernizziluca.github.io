---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LinkedInEmbed from '../../../components/LinkedInEmbed.astro';
import { UI, languages, type Lang } from '../../../i18n';
import { linkedinPosts } from '../../../data/site';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang }, props: { lang } })); }
const lang = Astro.props.lang as Lang;
const ui = UI[lang];
const base = import.meta.env.BASE_URL;
const to = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const posts = linkedinPosts.sort((a, b) => a.order - b.order);
---
<BaseLayout lang={lang} title={`${ui.linkedin.title} - Luca Invernizzi`} description={ui.linkedin.intro} page="linkedin">
  <main>
    <section class="section-padding py-12 sm:py-20">
      <div class="container-page">
        <a href={to(`${lang}/#linkedin`)} class="inline-flex items-center gap-2 text-sm font-bold text-muted transition hover:text-ink">← {ui.linkedin.back}</a>
        <div class="reveal mt-8 max-w-3xl">
          <p class="kicker">LinkedIn Database</p>
          <h1 class="mt-4 text-5xl font-black tracking-[-0.05em] sm:text-7xl">{ui.linkedin.title}</h1>
          <p class="mt-5 text-lg leading-8 text-muted">{ui.linkedin.intro}</p>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-2">
          {posts.map((post) => <LinkedInEmbed post={post} lang={lang} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
