---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { UI, languages, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const works = await getCollection('arbeiten');
  return works.flatMap((entry) => languages.map((lang) => ({ params: { lang, slug: entry.slug }, props: { entry, lang } })));
}
const entry = Astro.props.entry;
const lang = Astro.props.lang as Lang;
const ui = UI[lang];
const data = entry.data;
const t = data.translations[lang] ?? data.translations.de;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const to = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const allWorks = (await getCollection('arbeiten')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allWorks.findIndex((work) => work.slug === entry.slug);
const nextWork = allWorks[(currentIndex + 1) % allWorks.length];
const nextT = nextWork.data.translations[lang] ?? nextWork.data.translations.de;
---
<BaseLayout lang={lang} title={`${t.title} - Luca Invernizzi`} description={t.short} slug={entry.slug}>
  <main>
    <section class="section-padding py-10 sm:py-16">
      <div class="container-page">
        <a href={to(`${lang}/#arbeiten`)} class="inline-flex items-center gap-2 text-sm font-bold text-muted transition hover:text-ink">← {ui.detail.back}</a>
        <div class="mt-8 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div class="reveal">
            <p class="kicker">{t.category}</p>
            <h1 class="mt-5 text-balance text-5xl font-black tracking-[-0.05em] sm:text-7xl">{t.title}</h1>
            <p class="mt-5 text-xl font-semibold text-caramelDark">{t.role}</p>
            <div class="mt-5 flex flex-wrap gap-2 text-sm font-semibold text-muted">
              <span class="rounded-full bg-white px-4 py-2 ring-1 ring-black/5">{t.period}</span>
              <span class="rounded-full bg-white px-4 py-2 ring-1 ring-black/5">{t.location}</span>
            </div>
          </div>
          <p class="reveal text-lg leading-8 text-muted">{t.intro}</p>
        </div>
        <div class="reveal mt-10 overflow-hidden rounded-[2.5rem] bg-white p-3 shadow-soft">
          <img src={asset(data.cover)} alt={t.title} class="aspect-[16/8] w-full rounded-[2rem] object-cover" />
        </div>
      </div>
    </section>

    <section class="section-padding py-12 sm:py-20">
      <div class="container-page grid gap-6 lg:grid-cols-3">
        <article class="reveal rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5"><h2 class="text-2xl font-black tracking-tight">{ui.detail.situation}</h2><p class="mt-5 text-base leading-7 text-muted">{t.situation}</p></article>
        <article class="reveal rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5 lg:col-span-2"><h2 class="text-2xl font-black tracking-tight">{ui.detail.tasks}</h2><ul class="mt-5 grid gap-3 sm:grid-cols-2">{t.tasks.map((task: string) => <li class="flex gap-3 text-base leading-7 text-muted"><span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-caramel"></span>{task}</li>)}</ul></article>
      </div>
    </section>

    <section class="section-padding py-12 sm:py-20">
      <div class="container-page grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        <article class="reveal rounded-[2rem] bg-ink p-8 text-white sm:p-10"><h2 class="text-3xl font-black tracking-tight">{ui.detail.results}</h2><div class="mt-7 grid gap-4 sm:grid-cols-2">{t.results.map((result: string) => <div class="rounded-[1.4rem] bg-white/8 p-5 ring-1 ring-white/10"><p class="text-base leading-7 text-white/78">{result}</p></div>)}</div></article>
        <article class="reveal rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5 sm:p-10"><h2 class="text-3xl font-black tracking-tight">{ui.detail.tools}</h2><div class="mt-6 flex flex-wrap gap-2">{data.tools.map((tool: string) => <span class="rounded-full bg-paper px-4 py-2 text-sm font-semibold text-muted">{tool}</span>)}</div></article>
      </div>
    </section>

    <section class="section-padding py-12 sm:py-20">
      <div class="container-page"><div class="reveal max-w-3xl"><p class="kicker">{ui.detail.gallery}</p><h2 class="mt-4 text-4xl font-black tracking-[-0.04em] sm:text-5xl">{t.title}</h2></div><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{data.gallery.map((image: string, index: number) => <div class="reveal overflow-hidden rounded-[1.8rem] bg-white p-2 shadow-sm ring-1 ring-black/5"><img src={asset(image)} alt={`${t.title} ${index + 1}`} class="aspect-[4/3] w-full rounded-[1.4rem] object-cover" loading="lazy" /></div>)}</div></div>
    </section>

    {(data.links.length > 0 || data.companyUrl) && <section class="section-padding py-8 sm:py-12"><div class="container-page reveal rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5 sm:p-10"><p class="kicker">{ui.detail.links}</p><div class="mt-6 flex flex-wrap gap-3">{data.companyUrl && <a class="btn-secondary" href={data.companyUrl} target="_blank" rel="noreferrer">Website ↗</a>}{data.links.map((link: { label: string; url: string }) => <a class="btn-secondary" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></div></section>}

    {data.evidence.length > 0 && <section class="section-padding py-8 sm:py-12"><div class="container-page reveal rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5 sm:p-10"><p class="kicker">{ui.detail.evidence}</p>{data.evidence.map((ev: {label:string; pdf?:string; url?:string; note?:string}) => <div class="mt-6 rounded-3xl border border-black/10 bg-white/70 p-5"><h3 class="font-extrabold">{ev.label}</h3>{ev.note && <p class="mt-2 text-sm leading-6 text-muted">{ev.note}</p>}{ev.pdf && <iframe class="pdf-viewer mt-4" src={asset(ev.pdf)} title={ev.label} loading="lazy"></iframe>}</div>)}</div></section>}

    <section class="section-padding py-12 sm:py-20"><div class="container-page grid gap-6 lg:grid-cols-[0.85fr_1.15fr]"><div class="reveal rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5 sm:p-10"><h2 class="text-3xl font-black tracking-tight">{ui.detail.learnings}</h2></div><div class="reveal rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5 sm:p-10"><ul class="grid gap-4">{t.learnings.map((learning: string) => <li class="flex gap-3 text-lg leading-8 text-muted"><span class="mt-3 h-2 w-2 shrink-0 rounded-full bg-caramel"></span>{learning}</li>)}</ul></div></div></section>

    <section class="section-padding py-12 sm:py-20"><div class="container-page flex flex-col gap-4 rounded-[2rem] bg-white/80 p-8 ring-1 ring-black/5 sm:flex-row sm:items-center sm:justify-between sm:p-10"><a class="btn-secondary" href={to(`${lang}/#arbeiten`)}>← {ui.detail.back}</a><a class="btn-primary" href={to(`${lang}/arbeiten/${nextWork.slug}/`)}>{ui.detail.next}: {nextT.title} →</a></div></section>
  </main>
</BaseLayout>
