---
// Top of a case study: back link, title, role, summary, big image, key facts.
import Img from './Img.astro';
import Disc from './Disc.astro';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n';
import { formatPeriod, localized, tr, type Work } from '../lib/content';
import { homeUrl } from '../lib/url';

interface Props {
  entry: Work;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const data = entry.data;
const text = localized(data, lang);
const t = ui[lang];
const current = !data.end;
const longTitle = Math.max(...text.title.split(/\s+/).map((word) => word.length)) > 13;
const host = data.website ? new URL(data.website).hostname.replace(/^www\./, '') : undefined;
const credits = [
  { label: t.caseStudy.company, value: tr(data.company, lang) },
  { label: t.caseStudy.role, value: text.role },
  { label: t.caseStudy.period, value: formatPeriod(data.start, data.end, lang) },
  { label: t.caseStudy.location, value: tr(data.location, lang) },
  ...(data.website && host ? [{ label: t.caseStudy.website, value: host, href: data.website }] : []),
];
---
<header class="wrap case-hero">
  <a class="back-link" href={`${homeUrl(lang)}#arbeiten`}><Icon name="arrow-left" />{t.caseStudy.back}</a>
  <div class="case-hero__head">
    <p class="case-hero__label">
      <span class="label">{text.category}</span>
      {current && <span class="case-hero__status"><Disc />{t.status.current}</span>}
    </p>
    <h1 class:list={['display h1', { 'h1--long': longTitle }]}>{text.title}</h1>
    <p class="case-hero__role">{text.role}</p>
    <p class="lead">{text.summary}</p>
  </div>
  <figure class="case-hero__media">
    <Img
      src={data.cover.src}
      alt={tr(data.cover.alt, lang)}
      position={data.cover.position}
      loading="eager"
      fetchpriority="high"
      sizes="(min-width: 1260px) 75rem, 96vw"
      style={`view-transition-name: case-${entry.slug}`}
    />
  </figure>
  <dl class="credits" style={`--credit-cols: ${credits.length}`}>
    {
      credits.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>
            {'href' in item && item.href ? (
              <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">
                {item.value}
              </a>
            ) : (
              item.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</header>
