---
// Top of a case study or education page: back link, label, title, role, summary, cover image, key facts.
import Img from './Img.astro';
import Icon from './Icon.astro';
import ExtLink from './ExtLink.astro';
import type { Img as ImageData } from '../lib/content';
import { tr } from '../lib/content';
import { imageInfo } from '../lib/images';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  back: { href: string; label: string };
  label: string;
  current?: { label: string };
  title: string;
  role: string;
  summary: string;
  cover: ImageData;
  coverAlt?: string;
  facts: { label: string; value: string; href?: string }[];
  externalLabel: string;
}

const { lang, back, label, current, title, role, summary, cover, coverAlt, facts, externalLabel } = Astro.props;
// Small source images are shown at their natural size instead of being blown up to the full width.
const naturalWidth = imageInfo(cover.src)?.width;
const small = naturalWidth !== undefined && naturalWidth < 1000;
---
<header class="case-hero container">
  <a class="back-link" href={back.href}>
    <Icon name="arrow-left" />
    {back.label}
  </a>
  <p class="case-hero__label">
    <span>{label}</span>
    {current && <span class="badge">{current.label}</span>}
  </p>
  <h1 class="case-hero__title">{title}</h1>
  <p class="case-hero__role">{role}</p>
  <p class="case-hero__lead">{summary}</p>
</header>
<figure class:list={['case-cover container', { 'case-cover--small': small }]}>
  <div class="case-cover__frame" style={small ? `max-width: ${naturalWidth}px` : undefined}>
    <Img
      src={cover.src}
      alt={coverAlt ?? tr(cover.alt, lang)}
      position={cover.position}
      loading="eager"
      fetchpriority="high"
      sizes="(min-width: 1240px) 75rem, 94vw"
    />
  </div>
</figure>
<div class="container">
  <dl class="facts">
    {
      facts.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>
            {item.href ? (
              <ExtLink href={item.href} label={item.value} external={externalLabel} />
            ) : (
              item.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
