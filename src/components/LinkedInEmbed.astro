---
import type { Lang } from '../i18n';
const { post, lang } = Astro.props;
const currentLang = lang as Lang;
const title = post.title[currentLang] ?? post.title.de;
---
<article data-tilt-card class="linkedin-embed-card reveal">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h3 class="text-sm font-extrabold text-ink">{title}</h3>
    <span class="rounded-full bg-[#0A66C2]/10 px-3 py-1 text-xs font-bold text-[#0A66C2]">LinkedIn</span>
  </div>
  <div class="linkedin-frame-wrap">
    <iframe src={post.src} height={post.height} width="504" frameborder="0" allowfullscreen title="LinkedIn embedded post" loading="lazy"></iframe>
  </div>
</article>
