---
import type { Lang } from '../i18n';

type LinkedInPost = {
  id: string;
  title: Record<string, string>;
  excerpt: Record<string, string>;
  tag?: Record<string, string>;
  image?: string;
  url: string;
};

const { post, lang = 'de' } = Astro.props as { post: LinkedInPost; lang?: Lang };
const base = import.meta.env.BASE_URL;
const asset = (path?: string) => (path ? `${base}${path.replace(/^\/+/, '')}` : '');
---
<a
  data-tilt-card
  href={post.url}
  target="_blank"
  rel="noopener noreferrer"
  class="linkedin-preview-card group reveal flex h-full flex-col overflow-hidden rounded-[2rem]"
>
  {post.image && (
    <div class="linkedin-preview-media aspect-[16/10] overflow-hidden">
      <img src={asset(post.image)} alt={post.title[lang] ?? post.title.de} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
    </div>
  )}
  <div class="flex flex-1 flex-col gap-4 p-6">
    <div class="flex items-center justify-between gap-3">
      <span class="rounded-full bg-[#e8f1ff] px-3 py-1 text-xs font-bold text-[#0a66c2]">LinkedIn</span>
      {post.tag && <span class="text-xs font-bold uppercase tracking-[0.18em] text-caramelDark">{post.tag[lang] ?? post.tag.de}</span>}
    </div>
    <div>
      <h3 class="text-2xl font-black tracking-[-0.03em] text-ink">{post.title[lang] ?? post.title.de}</h3>
      <p class="mt-3 text-sm leading-7 text-muted">{post.excerpt[lang] ?? post.excerpt.de}</p>
    </div>
    <div class="mt-auto inline-flex items-center gap-2 text-sm font-extrabold text-ink">
      Beitrag auf LinkedIn öffnen <span class="transition group-hover:translate-x-0.5">→</span>
    </div>
  </div>
</a>
