---
import Disc from './Disc.astro';
import { languageLabels, languageNames, languages, ui, type Lang } from '../i18n';
import { asset, homeUrl } from '../lib/url';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;
const t = ui[lang];
const home = homeUrl(lang);
const nav = [
  { href: `${home}#werdegang`, label: t.nav.werdegang },
  { href: `${home}#arbeiten`, label: t.nav.arbeiten },
  { href: `${home}#nachweise`, label: t.nav.nachweise },
  { href: `${home}#kontakt`, label: t.nav.kontakt },
];
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={home} aria-label="Luca Invernizzi">
      <img src={asset('/images/brand/li-logo-96.png')} alt="" width="40" height="40" />
      <span>Luca Invernizzi</span>
    </a>

    <nav class="site-nav" aria-label={t.menu}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="lang-switch" role="group" aria-label={t.languageSwitch}>
      {
        languages.map((code) => (
          <a
            href={alternates[code]}
            hreflang={code}
            lang={code}
            title={languageNames[code]}
            aria-current={code === lang ? 'true' : undefined}
          >
            {languageLabels[code]}
          </a>
        ))
      }
    </div>

    <details class="menu">
      <summary aria-label={t.menu}><span class="menu__bars" aria-hidden="true"></span></summary>
      <nav class="menu__panel" aria-label={t.menu}>
        {
          nav.map((item) => (
            <a href={item.href}>
              <Disc />
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  // Mobile menu: close after choosing a section, on outside click and on Escape.
  document.querySelectorAll('details.menu').forEach((menu) => {
    const close = () => menu.removeAttribute('open');
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('click', (event) => {
      if (menu.hasAttribute('open') && !menu.contains(event.target)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  });
</script>
