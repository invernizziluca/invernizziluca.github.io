---
// Five discs, like the skill ratings in the CV.
import Disc from './Disc.astro';

interface Props {
  level: number;
  label: string;
}
const { level, label } = Astro.props;
const discs = Array.from({ length: 5 }, (_, index) => index < level);
---
<span class="rating" role="img" aria-label={label}>
  {discs.map((filled) => <Disc empty={!filled} />)}
</span>
