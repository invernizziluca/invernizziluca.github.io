---
import { ui, type Lang } from '../i18n';
import { getHome, tr } from '../lib/content';
import { asset } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const home = await getHome();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p>© {year} Luca Invernizzi, {tr(home.contact.city, lang)}</p>
    <nav aria-label="Footer">
      <a href={`mailto:${home.contact.email}`}>E-Mail</a>
      <a href={home.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={asset(home.contact.cv)} target="_blank" rel="noopener">{t.contact.cv}</a>
      <a href="#top">{t.footer.top}</a>
    </nav>
  </div>
</footer>
