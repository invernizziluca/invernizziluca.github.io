---
import { UI, type Lang } from '../i18n';
const lang = (Astro.props.lang ?? 'de') as Lang;
const ui = UI[lang];
const base = import.meta.env.BASE_URL;
const to = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---
<footer class="section-padding border-t border-black/5 py-10">
  <div class="container-page flex flex-col gap-4 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>{ui.footer.rights}</p>
    <div class="flex flex-wrap gap-4">
      <a class="hover:text-ink" href={to(`${lang}/#arbeiten`)}>{ui.nav.arbeiten}</a>
      <a class="hover:text-ink" href={to(`${lang}/linkedin/`)}>{ui.nav.linkedin}</a>
      <a class="hover:text-ink" href={to(`${lang}/#kontakt`)}>{ui.nav.kontakt}</a>
    </div>
  </div>
</footer>
