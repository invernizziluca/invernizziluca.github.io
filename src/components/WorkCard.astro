---
// Uniform card for a case study (home page + "Weitere Projekte").
import Img from './Img.astro';
import Disc from './Disc.astro';
import { ui, type Lang } from '../i18n';
import { formatPeriod, localized, tr, type Work } from '../lib/content';
import { workUrl } from '../lib/url';

interface Props {
  entry: Work;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const data = entry.data;
const text = localized(data, lang);
const href = workUrl(lang, entry.slug);
const current = !data.end;
const t = ui[lang];
---
<article class="work-card">
  <div class="work-card__media">
    <Img
      src={data.cover.src}
      alt={tr(data.cover.alt, lang)}
      position={data.cover.position}
      sizes="(min-width: 1200px) 36rem, (min-width: 760px) 46vw, 92vw"
      style={`view-transition-name: case-${entry.slug}`}
    />
    {current && <span class="badge"><Disc />{t.card.current}</span>}
  </div>
  <div class="work-card__body">
    <p class="work-card__meta">{formatPeriod(data.start, data.end, lang)}, {tr(data.location, lang)}</p>
    <h3 class="display h3"><a class="work-card__title" href={href}>{text.title}</a></h3>
    <p class="work-card__role">{text.role}</p>
    <p class="work-card__summary">{text.summary}</p>
    <span class="work-card__cta" aria-hidden="true">{t.card.read}</span>
  </div>
</article>
