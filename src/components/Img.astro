---
// Responsive image: uses the variants generated by scripts/prepare-images.mjs when available.
import { imageInfo } from '../lib/images';
import { asset } from '../lib/url';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  position?: string;
  class?: string;
  style?: string;
}

const { src, alt, sizes = '100vw', loading = 'lazy', fetchpriority, position, class: className, style } = Astro.props;
const info = imageInfo(src);
const variants = info?.variants ?? [];
const srcset =
  info && variants.length > 0
    ? [...variants.map((variant) => `${asset(variant.src)} ${variant.w}w`), `${asset(src)} ${info.width}w`].join(', ')
    : undefined;
const inlineStyle = [position ? `object-position: ${position}` : '', style ?? ''].filter(Boolean).join('; ') || undefined;
---
<img
  src={asset(src)}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={info?.width}
  height={info?.height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
  style={inlineStyle}
/>
