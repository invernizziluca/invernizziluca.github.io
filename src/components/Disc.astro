---
// Small CD used as marker (bullets, timeline, ratings). Pure CSS, see .disc in site.css.
interface Props {
  size?: string;
  empty?: boolean;
  class?: string;
}
const { size, empty = false, class: className } = Astro.props;
---
<span class:list={['disc', { 'disc--empty': empty }, className]} style={size ? `--disc: ${size}` : undefined} aria-hidden="true"></span>
