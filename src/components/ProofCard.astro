---
// A proof document: reference letter, article, certificate or research paper. Content: src/content/nachweise/*.yaml
import Img from './Img.astro';
import Icon from './Icon.astro';
import ExtLink from './ExtLink.astro';
import { ui, type Lang } from '../i18n';
import { formatDate, localized, type Proof } from '../lib/content';
import { asset } from '../lib/url';

interface Props {
  entry: Proof;
  lang: Lang;
  related?: { label: string; href: string };
  /** heading level of the document title (4 on the home page, 3 on case study pages) */
  headingLevel?: 3 | 4;
}

const { entry, lang, related, headingLevel = 4 } = Astro.props;
const data = entry.data;
const text = localized(data, lang);
const t = ui[lang];
const Title = headingLevel === 3 ? 'h3' : 'h4';
---
<li class="doc">
  <div class="doc__thumb">
    {data.image ? <Img src={data.image.src} alt="" position={data.image.position} sizes="88px" /> : <Icon name="file" />}
  </div>
  <div class="doc__text">
    <p class="doc__meta">
      <span>{t.proofTypes[data.type]}</span>
      <time datetime={data.date}>{formatDate(data.date, lang)}</time>
    </p>
    <Title class="doc__title">{text.title}</Title>
    <p class="doc__source">{data.source}</p>
    <p class="doc__summary">{text.summary}</p>
    <p class="doc__actions">
      {
        data.pdf && (
          <a class="link link--strong" href={asset(data.pdf)} target="_blank" rel="noopener">
            {t.proofActions.pdf}
            <span class="sr-only">{`: ${text.title}`}</span>
          </a>
        )
      }
      {
        data.url && (
          <ExtLink class="link link--strong" href={data.url} label={t.proofActions.link} external={t.external} srText={`: ${text.title} (${t.external})`} />
        )
      }
      {related && <a class="link" href={related.href}>{related.label}</a>}
    </p>
  </div>
</li>
