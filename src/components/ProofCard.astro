---
// A proof document: reference letter, article, certificate or research paper.
import Img from './Img.astro';
import Disc from './Disc.astro';
import { ui, type Lang } from '../i18n';
import { formatDate, localized, type Proof } from '../lib/content';
import { asset } from '../lib/url';

interface Props {
  entry: Proof;
  lang: Lang;
  related?: { label: string; href: string };
  variant?: 'row' | 'card';
}

const { entry, lang, related, variant = 'row' } = Astro.props;
const data = entry.data;
const text = localized(data, lang);
const t = ui[lang];
const Tag = variant === 'row' ? 'li' : 'article';
---
<Tag class={variant === 'row' ? 'proof' : 'proof-card'}>
  <div class="proof__thumb">
    {data.image ? <Img src={data.image.src} alt="" position={data.image.position} sizes="68px" /> : <Disc size="2.5rem" />}
  </div>
  <div class="proof__text">
    <p class="proof__meta">
      <span class="proof__type">{t.proofTypes[data.type]}</span>
      <time datetime={data.date}>{formatDate(data.date, lang)}</time>
      <span>{data.source}</span>
    </p>
    <h4 class="proof__title">{text.title}</h4>
    <p class="proof__summary">{text.summary}</p>
  </div>
  <p class="proof__actions">
    {
      data.pdf && (
        <a class="text-link" href={asset(data.pdf)} target="_blank" rel="noopener">
          {t.proofActions.pdf}
        </a>
      )
    }
    {
      data.url && (
        <a class="text-link" href={data.url} target="_blank" rel="noopener noreferrer">
          {t.proofActions.link}
        </a>
      )
    }
    {related && <a class="text-link" href={related.href}>{related.label}</a>}
  </p>
</Tag>
