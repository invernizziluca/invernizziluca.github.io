---
// Spotify player that only loads after a click (privacy + page speed).
// Accepts any normal Spotify share link: playlist, artist, album or track.
import Disc from './Disc.astro';
import { ui, type Lang } from '../i18n';
import { spotifyLink } from '../lib/content';

interface Props {
  url: string;
  title?: string;
  note?: string;
  lang: Lang;
  compact?: boolean;
  consent?: boolean;
}

const { url, title, note, lang, compact = false, consent = true } = Astro.props;
const t = ui[lang];
const link = spotifyLink(url);
const typeLabels: Record<string, string> = {
  playlist: t.spotify.playlist,
  artist: t.spotify.artist,
  album: t.spotify.album,
  track: t.spotify.track,
};
const height = compact || link?.type === 'track' ? 152 : 352;
const name = title ?? typeLabels[link?.type ?? ''] ?? 'Spotify';
---
{
  link && compact && (
    <div
      class="spotify spotify--compact"
      data-spotify-src={link.embed}
      data-spotify-height={height}
      data-spotify-title={`Spotify: ${name}`}
    >
      <div class="spotify__facade">
        <Disc class="spotify__disc" />
        <p class="spotify__title">
          <a href={link.open} target="_blank" rel="noopener noreferrer">{name}</a>
        </p>
        <button type="button" class="btn btn--ghost btn--small" data-spotify-load aria-label={`${t.spotify.load}: ${name}`}>
          {t.spotify.listen}
        </button>
      </div>
    </div>
  )
}
{
  link && !compact && (
    <div class="spotify" data-spotify-src={link.embed} data-spotify-height={height} data-spotify-title={`Spotify: ${name}`}>
      <div class="spotify__facade">
        <Disc class="spotify__disc" />
        <div>
          <p class="spotify__type">{typeLabels[link.type] ?? 'Spotify'}</p>
          <p class="spotify__title">{name}</p>
          {note && <p class="spotify__note">{note}</p>}
        </div>
        <div class="spotify__actions">
          <button type="button" class="btn btn--primary btn--small" data-spotify-load>
            {t.spotify.load}
          </button>
          <a class="text-link" href={link.open} target="_blank" rel="noopener noreferrer">
            {t.spotify.open}
          </a>
        </div>
        {consent && <p class="spotify__consent">{t.spotify.consent}</p>}
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll('[data-spotify-load]').forEach((button) => {
    button.addEventListener('click', () => {
      const box = button.closest('[data-spotify-src]');
      if (!box || box.hasAttribute('data-loaded')) return;
      const frame = document.createElement('iframe');
      frame.src = box.getAttribute('data-spotify-src') || '';
      frame.height = box.getAttribute('data-spotify-height') || '352';
      frame.title = box.getAttribute('data-spotify-title') || 'Spotify';
      frame.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      frame.setAttribute('loading', 'lazy');
      box.appendChild(frame);
      box.setAttribute('data-loaded', '');
      frame.focus();
    });
  });
</script>
