---
// The home page (same component for /, /de/, /en/, /it/).
// Order for a reader with 15–30 seconds: who + role + CV -> selected work -> roles -> proof -> education -> contact.
// Texts: src/content/home/home.yaml · Roles: src/content/arbeiten · Proof: src/content/nachweise, linkedin, referenzen
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from './Img.astro';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import SelectedWork from './SelectedWork.astro';
import ReferenceCard from './ReferenceCard.astro';
import LinkedInCard from './LinkedInCard.astro';
import ProofCard from './ProofCard.astro';
import { languages, ui, type Lang } from '../i18n';
import {
  formatPeriod,
  getEducation,
  getHome,
  getPosts,
  getProofs,
  getReferences,
  getWorks,
  localized,
  tr,
} from '../lib/content';
import { absoluteUrl, asset, educationUrl, homeUrl, workUrl } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const home = await getHome();
const works = await getWorks();
const education = await getEducation();
const posts = (await getPosts()).filter((entry) => entry.data.showOnHome).slice(0, 3);
const proofs = await getProofs();
const references = await getReferences();
const featuredReference = references.find((entry) => entry.data.featured) ?? references[0];
const otherReferences = references.filter((entry) => entry !== featuredReference);

// Which page a LinkedIn post or a proof document belongs to ("Gehört zu …").
const relatedPost = new Map<string, { label: string; href: string }>();
const relatedProof = new Map<string, { label: string; href: string }>();
for (const entry of works) {
  const href = workUrl(lang, entry.slug);
  const post = { label: localized(entry.data, lang).title, href };
  const proof = { label: t.proofActions.case, href };
  entry.data.linkedin.forEach((ref) => relatedPost.has(ref.id) || relatedPost.set(ref.id, post));
  entry.data.nachweise.forEach((ref) => relatedProof.has(ref.id) || relatedProof.set(ref.id, proof));
}
for (const entry of education) {
  const href = educationUrl(lang, entry.slug);
  const post = { label: tr(entry.data.institution, lang), href };
  const proof = { label: t.proofActions.education, href };
  entry.data.linkedin.forEach((ref) => relatedPost.has(ref.id) || relatedPost.set(ref.id, post));
  entry.data.nachweise.forEach((ref) => relatedProof.has(ref.id) || relatedProof.set(ref.id, proof));
}

const alternates = Object.fromEntries(languages.map((code) => [code, homeUrl(code)])) as Record<Lang, string>;
const currentWork = works.find((entry) => !entry.data.end);
const educationNewestFirst = [...education].sort((a, b) => b.data.start.localeCompare(a.data.start));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Luca Invernizzi',
  url: absoluteUrl(homeUrl(lang), Astro.site),
  image: absoluteUrl(home.portrait.src, Astro.site),
  description: tr(home.seo.description, lang),
  email: `mailto:${home.contact.email}`,
  sameAs: [home.contact.linkedin],
  knowsLanguage: ['it', 'de', 'en', 'fr'],
  ...(currentWork
    ? {
        jobTitle: localized(currentWork.data, lang).role,
        worksFor: { '@type': 'Organization', name: tr(currentWork.data.company, lang), url: currentWork.data.website },
      }
    : {}),
  // Finished schools are alumniOf, the current degree programme is an affiliation.
  alumniOf: education
    .filter((entry) => entry.data.end)
    .map((entry) => ({ '@type': 'EducationalOrganization', name: tr(entry.data.institution, lang) })),
  affiliation: education
    .filter((entry) => !entry.data.end)
    .map((entry) => ({ '@type': 'CollegeOrUniversity', name: tr(entry.data.institution, lang), url: entry.data.website })),
};
---
<BaseLayout
  lang={lang}
  title={tr(home.seo.title, lang)}
  description={tr(home.seo.description, lang)}
  image={home.ogImage}
  imageAlt="Luca Invernizzi"
  alternates={alternates}
  canonical={homeUrl(lang)}
  type="profile"
  jsonLd={jsonLd}
>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__text">
      <p class="hero__kicker">{tr(home.hero.kicker, lang)}</p>
      <h1 class="hero__title" id="hero-title">{home.hero.title}</h1>
      <p class="hero__claim">{tr(home.hero.claim, lang)}</p>
      <p class="hero__lead">{tr(home.hero.lead, lang)}</p>
      <div class="actions">
        <a class="btn btn--primary" href="#arbeiten">{tr(home.hero.primary, lang)}</a>
        <a class="btn btn--secondary" href={asset(home.contact.cv)} target="_blank" rel="noopener">
          <Icon name="file" />
          {tr(home.hero.secondary, lang)}
        </a>
      </div>
    </div>
    <figure class="hero__media">
      <Img
        src={home.portrait.src}
        alt={tr(home.portrait.alt, lang)}
        position={home.portrait.position}
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 1240px) 28rem, (min-width: 900px) 38vw, 92vw"
      />
    </figure>
    <dl class="hero__facts">
      {
        home.hero.facts.map((fact) => (
          <div>
            <dt>{tr(fact.label, lang)}</dt>
            <dd>{tr(fact.value, lang)}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <SelectedWork data={home.selectedWork} lang={lang} />

  <section class="section" id="stationen" aria-labelledby="stationen-title">
    <div class="container">
      <SectionHead id="stationen-title" title={tr(home.stationen.title, lang)} intro={tr(home.stationen.intro, lang)} />
      <ol class="rows" role="list">
        {
          works.map((entry) => {
            const text = localized(entry.data, lang);
            const href = workUrl(lang, entry.slug);
            return (
              <li class="row">
                <div class="row__thumb">
                  <Img src={entry.data.cover.src} alt="" position={entry.data.cover.position} sizes="96px" />
                </div>
                <p class="row__period">
                  {formatPeriod(entry.data.start, entry.data.end, lang)}
                  {!entry.data.end && <span class="badge">{t.status.current}</span>}
                </p>
                <div class="row__main">
                  <h3 class="row__title">
                    <a class="row__link" href={href}>{tr(entry.data.company, lang)}</a>
                  </h3>
                  <p class="row__role">{text.role}</p>
                </div>
                <p class="row__summary">{text.summary}</p>
                <span class="row__cta" aria-hidden="true">
                  {t.stations.read}
                  <Icon name="arrow-right" />
                </span>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <section class="section section--tint" id="nachweise" aria-labelledby="nachweise-title">
    <div class="container">
      <SectionHead id="nachweise-title" title={tr(home.nachweise.title, lang)} intro={tr(home.nachweise.intro, lang)} />

      <div class="quotes">
        {featuredReference && <ReferenceCard entry={featuredReference} lang={lang} featured />}
        {otherReferences.map((entry) => <ReferenceCard entry={entry} lang={lang} />)}
      </div>

      <h3 class="subhead">{tr(home.nachweise.documentsTitle, lang)}</h3>
      <ul class="docs" role="list">
        {proofs.map((entry) => <ProofCard entry={entry} lang={lang} related={relatedProof.get(entry.id)} />)}
      </ul>

      {
        posts.length > 0 && (
          <>
            <div class="subhead-row">
              <h3 class="subhead">{tr(home.nachweise.postsTitle, lang)}</h3>
              <p>{tr(home.nachweise.postsIntro, lang)}</p>
            </div>
            <div class="posts">
              {posts.map((entry) => (
                <LinkedInCard entry={entry} lang={lang} related={relatedPost.get(entry.id)} />
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="section" id="ausbildung" aria-labelledby="ausbildung-title">
    <div class="container split">
      <div>
        <SectionHead id="ausbildung-title" title={tr(home.ausbildung.title, lang)} />
        <ol class="rows rows--compact" role="list">
          {
            educationNewestFirst.map((entry) => {
              const text = localized(entry.data, lang);
              return (
                <li class="row row--compact">
                  <p class="row__period">{formatPeriod(entry.data.start, entry.data.end, lang, entry.data.expectedEnd)}</p>
                  <div class="row__main">
                    <h3 class="row__title">
                      <a class="row__link" href={educationUrl(lang, entry.slug)}>{text.title}</a>
                    </h3>
                    <p class="row__role">{tr(entry.data.institution, lang)}</p>
                  </div>
                  <span class="row__cta" aria-hidden="true">
                    <Icon name="arrow-right" />
                  </span>
                </li>
              );
            })
          }
        </ol>
      </div>

      <section class="skills" aria-labelledby="skills-title">
        <SectionHead id="skills-title" title={tr(home.skills.title, lang)} />
        <h3 class="subhead subhead--small">{t.skills.languages}</h3>
        <dl class="languages">
          {
            home.skills.languages.map((item) => (
              <div>
                <dt>{tr(item.name, lang)}</dt>
                <dd>{tr(item.level, lang)}</dd>
              </div>
            ))
          }
        </dl>
        <h3 class="subhead subhead--small">{t.skills.tools}</h3>
        <dl class="tool-groups">
          {
            home.skills.groups.map((group) => (
              <div>
                <dt>{tr(group.title, lang)}</dt>
                <dd>
                  <ul class="chips" role="list">
                    {group.items.map((tool) => (
                      <li>{tool}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
        {home.skills.note && <p class="note-text">{tr(home.skills.note, lang)}</p>}
      </section>
    </div>
  </section>

  <section class="section contact" id="kontakt" aria-labelledby="kontakt-title">
    <div class="container contact__inner">
      <h2 class="contact__title" id="kontakt-title">{tr(home.kontakt.title, lang)}</h2>
      <p class="contact__text">{tr(home.kontakt.text, lang)}</p>
      <div class="actions actions--center">
        <a class="btn btn--primary" href={`mailto:${home.contact.email}`}>
          <Icon name="mail" />
          {t.contact.email}
        </a>
        <a class="btn btn--secondary" href={home.contact.linkedin} target="_blank" rel="noopener noreferrer">{t.contact.linkedin}</a>
        <a class="btn btn--secondary" href={asset(home.contact.cv)} target="_blank" rel="noopener">{t.contact.cv}</a>
      </div>
      <p class="contact__mail"><a href={`mailto:${home.contact.email}`}>{home.contact.email}</a></p>
    </div>
  </section>
</BaseLayout>
