---
// Heading of a home page chapter: number (only for real sequence), chapter name, title, intro.
interface Props {
  id: string;
  num?: string;
  name: string;
  title: string;
  intro?: string;
}
const { id, num, name, title, intro } = Astro.props;
---
<header class="chapter-head">
  <p class="chapter-head__mark">
    {num && <span class="chapter-head__num">{num}</span>}
    <span class="chapter-head__name">{name}</span>
  </p>
  <h2 class="display h2" id={id}>{title}</h2>
  {intro && <p class="lead">{intro}</p>}
</header>
