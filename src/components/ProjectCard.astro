---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n';

const { entry, lang = 'de', cta = 'Arbeit ansehen' } = Astro.props as { entry: CollectionEntry<'arbeiten'>; lang?: Lang; cta?: string };
const t = entry.data.translations[lang] ?? entry.data.translations.de;
const base = import.meta.env.BASE_URL;
const to = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const cardCategory = t.cardCategory ?? t.category;
const cardRole = t.cardRole ?? t.role;
const cardShort = t.cardShort ?? t.short;
---
<a data-tilt-card href={to(`${lang}/arbeiten/${entry.slug}/`)} class="project-card group flex flex-col overflow-hidden rounded-[2rem] shadow-soft transition-transform duration-300 hover:-translate-y-1">
  <div class="project-media relative aspect-[16/10] overflow-hidden">
    <img src={to(entry.data.cover)} alt={t.title} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
    <div class="absolute left-4 top-4 rounded-full bg-white/90 px-4 py-2 text-[11px] font-black uppercase tracking-[0.2em] text-caramelDark shadow">{cardCategory}</div>
    <div class="absolute bottom-5 right-5 rounded-full border border-black/10 bg-white/96 px-4 py-2 text-[11px] font-black uppercase tracking-[0.18em] text-ink shadow-lg backdrop-blur">{t.period}</div>
  </div>
  <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6">
    <div>
      <p class="text-sm font-semibold text-caramelDark">{cardRole}</p>
      <h3 class="mt-2 text-3xl font-black tracking-[-0.035em] text-ink">{t.title}</h3>
      <p class="mt-1 text-sm font-medium text-muted">{t.location}</p>
    </div>
    <p class="text-sm leading-7 text-muted">{cardShort}</p>
    <div class="mt-auto flex items-center justify-between pt-2">
      <span class="case-button">{cta} <span>→</span></span>
    </div>
  </div>
</a>
