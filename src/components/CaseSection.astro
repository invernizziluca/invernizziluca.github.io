---
// One block of a case study page: title column (sticky on desktop) + content.
interface Props {
  title: string;
  id: string;
}
const { title, id } = Astro.props;
---
<section class="case-section" id={id} aria-labelledby={`${id}-titel`}>
  <h2 class="case-section__title" id={`${id}-titel`}>{title}</h2>
  <div class="case-section__content">
    <slot />
  </div>
</section>
