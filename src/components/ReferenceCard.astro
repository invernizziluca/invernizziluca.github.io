---
// Quote from a recommendation or reference letter. Content: src/content/referenzen/*.yaml
import { ui, type Lang } from '../i18n';
import ExtLink from './ExtLink.astro';
import { formatDate, localized, tr, type Reference } from '../lib/content';
import { asset } from '../lib/url';

interface Props {
  entry: Reference;
  lang: Lang;
  featured?: boolean;
}

const { entry, lang, featured = false } = Astro.props;
const data = entry.data;
const t = ui[lang];
const text = localized(data, lang);
const ownTranslation = lang !== data.originalLanguage && Boolean(data[lang]?.quote);
const quoteLang = ownTranslation ? lang : data.originalLanguage;
const paragraphs = (value: string) =>
  value
    .split(/\n\s*\n/)
    .map((part) => part.trim())
    .filter(Boolean);
const initials = data.name
  .replace(/^(Dr\.|Prof\.)\s+/i, '')
  .split(/\s+/)
  .map((part) => part.charAt(0))
  .filter(Boolean);
const monogram = `${initials[0] ?? ''}${initials.length > 1 ? initials[initials.length - 1] : ''}`;
---
<figure class:list={['quote', { 'quote--featured': featured }]}>
  <blockquote class="quote__text" lang={quoteLang}>
    {paragraphs(text.quote).map((part) => <p>{part}</p>)}
  </blockquote>
  {ownTranslation && <p class="quote__note">{t.references.translated}</p>}
  <figcaption class="quote__person">
    {
      data.image ? (
        <img class="quote__avatar" src={asset(data.image.src)} alt="" width="48" height="48" loading="lazy" decoding="async" />
      ) : (
        <span class="quote__avatar quote__avatar--initials" aria-hidden="true">{monogram}</span>
      )
    }
    <span class="quote__who">
      <span class="quote__name">{data.name}</span>
      <span class="quote__role">{tr(data.role, lang)}</span>
      <span class="quote__source">
        {tr(data.source, lang)}, <time datetime={data.date}>{formatDate(data.date, lang)}</time>
      </span>
    </span>
  </figcaption>
  {
    (data.pdf || data.url) && (
      <p class="quote__links">
        {data.pdf && (
          <a class="link" href={asset(data.pdf)} target="_blank" rel="noopener">
            {t.references.pdf}
          </a>
        )}
        {data.url && (
          <ExtLink href={data.url} label={t.references.linkedin} external={t.external} />
        )}
      </p>
    )
  }
  {
    text.full && (
      <details class="quote__more">
        <summary>{t.references.full}</summary>
        <div class="quote__full" lang={quoteLang}>
          {paragraphs(text.full).map((part) => <p>{part}</p>)}
        </div>
      </details>
    )
  }
</figure>
