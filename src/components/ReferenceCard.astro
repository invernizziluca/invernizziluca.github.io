---
// Quote from a recommendation or reference letter.
import { ui, type Lang } from '../i18n';
import { formatDate, localized, tr, type Reference } from '../lib/content';
import { asset } from '../lib/url';

interface Props {
  entry: Reference;
  lang: Lang;
  featured?: boolean;
}

const { entry, lang, featured = false } = Astro.props;
const data = entry.data;
const t = ui[lang];
const text = localized(data, lang);
const ownTranslation = lang !== data.originalLanguage && Boolean(data[lang]?.quote);
const quoteLang = ownTranslation ? lang : data.originalLanguage;
const paragraphs = (value: string) =>
  value
    .split(/\n\s*\n/)
    .map((part) => part.trim())
    .filter(Boolean);
const initials = data.name
  .replace(/^(Dr\.|Prof\.)\s+/i, '')
  .split(/\s+/)
  .map((part) => part.charAt(0))
  .filter(Boolean);
const monogram = `${initials[0] ?? ''}${initials.length > 1 ? initials[initials.length - 1] : ''}`;
---
<figure class:list={['ref', { 'ref--featured': featured }]}>
  <blockquote class="ref__quote" lang={quoteLang}>
    {paragraphs(text.quote).map((part) => <p>{part}</p>)}
  </blockquote>
  {ownTranslation && <p class="ref__translated">{t.references.translated}</p>}
  <figcaption class="ref__person">
    {
      data.image ? (
        <img class="ref__avatar" src={asset(data.image.src)} alt="" width="56" height="56" loading="lazy" decoding="async" />
      ) : (
        <span class="ref__monogram" aria-hidden="true">{monogram}</span>
      )
    }
    <div>
      <p class="ref__name">{data.name}</p>
      <p class="ref__role">{tr(data.role, lang)}</p>
      <p class="ref__source">
        {tr(data.source, lang)}, <time datetime={data.date}>{formatDate(data.date, lang)}</time>
      </p>
    </div>
  </figcaption>
  {
    (data.pdf || data.url) && (
      <p class="ref__links">
        {data.pdf && (
          <a class="text-link" href={asset(data.pdf)} target="_blank" rel="noopener">
            {t.references.pdf}
          </a>
        )}
        {data.url && (
          <a class="text-link" href={data.url} target="_blank" rel="noopener noreferrer">
            {t.references.linkedin}
          </a>
        )}
      </p>
    )
  }
  {
    text.full && (
      <details>
        <summary>{t.references.full}</summary>
        <div class="ref__full" lang={quoteLang}>
          {paragraphs(text.full).map((part) => <p>{part}</p>)}
        </div>
      </details>
    )
  }
</figure>
