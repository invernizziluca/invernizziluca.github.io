---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI, type Lang } from '../i18n';
import '../styles/global.css';

type Props = { lang?: Lang; title?: string; description?: string; slug?: string; educationId?: string; page?: string };
const lang = Astro.props.lang ?? 'de';
const title = Astro.props.title ?? UI[lang].seoTitle;
const description = Astro.props.description ?? UI[lang].seoDescription;
const slug = Astro.props.slug ?? '';
const educationId = Astro.props.educationId ?? '';
const page = Astro.props.page ?? '';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={asset('images/og-image.webp')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <link rel="preload" as="image" href={asset('images/profile/luca-portrait.webp')} fetchpriority="high" />
    <link rel="preload" as="image" href={asset('images/textures/cv-paper.webp')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="ambient-bg" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="noise-overlay" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header lang={lang} slug={slug} educationId={educationId} page={page} />
    <slot />
    <Footer lang={lang} />
    <script>
      const progress = document.querySelector('.scroll-progress');
      const root = document.documentElement;
      const updateProgress = () => {
        const scroll = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = height > 0 ? scroll / height : 0;
        if (progress) progress.style.transform = `scaleX(${ratio})`;
        root.style.setProperty('--scroll-ratio', String(ratio));
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
      const reveals = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach((el, index) => {
        el.style.setProperty('--stagger', String(index % 6));
        observer.observe(el);
      });

      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (canHover) {
        document.querySelectorAll('[data-tilt-card]').forEach((card) => {
          card.addEventListener('pointermove', (event) => {
            const rect = card.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width) * 100;
            const y = ((event.clientY - rect.top) / rect.height) * 100;
            const rotateY = ((x - 50) / 50) * 3.2;
            const rotateX = -((y - 50) / 50) * 3.2;
            card.style.setProperty('--tilt-x', `${rotateY}deg`);
            card.style.setProperty('--tilt-y', `${rotateX}deg`);
            card.style.setProperty('--glow-x', `${x}%`);
            card.style.setProperty('--glow-y', `${y}%`);
          });
          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--tilt-x', '0deg');
            card.style.setProperty('--tilt-y', '0deg');
            card.style.setProperty('--glow-x', '50%');
            card.style.setProperty('--glow-y', '35%');
          });
        });
      }
    </script>
  </body>
</html>
