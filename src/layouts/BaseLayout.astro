---
import '../styles/global.css';
import '../styles/site.css';
import fontLatin from '../assets/fonts/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, ogLocales, ui, type Lang } from '../i18n';
import { absoluteUrl, asset } from '../lib/url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Social preview image: public path ("/images/…") or absolute URL. */
  image?: string;
  imageAlt?: string;
  /** URL of this page in every language (used for the language switch and hreflang). */
  alternates: Record<Lang, string>;
  /** Canonical path; defaults to the current URL. */
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  image = '/images/og/home.jpg',
  imageAlt,
  alternates,
  canonical,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const site = Astro.site;
const t = ui[lang];
const canonicalUrl = absoluteUrl(canonical ?? Astro.url.pathname, site);
const ogImage = absoluteUrl(image, site);
const isPreviewSize = /\/(generated\/og|images\/og)\/[^/]+\.jpe?g$/i.test(image);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    {!noindex && languages.map((code) => <link rel="alternate" hreflang={code} href={absoluteUrl(alternates[code], site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.de, site)} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Luca Invernizzi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {isPreviewSize && <meta property="og:image:width" content="1200" />}
    {isPreviewSize && <meta property="og:image:height" content="630" />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content={ogLocales[lang]} />
    {languages.filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3ece0" />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('/favicon.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={asset('/images/brand/li-mark-192.png')} />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href={asset('/sitemap.xml')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#inhalt">{t.skip}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
